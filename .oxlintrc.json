{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-unnecessary-condition": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-return": "error",
    "prefer-const": "error"
  },
  "env": {
    "builtin": true,
  },
}
